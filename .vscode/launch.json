{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Remote Attach (LocalStack)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 19891
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/lambdas/hello",
          "remoteRoot": "/var/task"
        },
        {
          "localRoot": "${workspaceFolder}/lambdas/health",
          "remoteRoot": "/var/task"
        }
      ],
      "justMyCode": false
    }
  ]
}
